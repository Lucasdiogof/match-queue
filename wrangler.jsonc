// Copy to the app repo root as wrangler.jsonc. Replace matchqueue-web and matchqueue.
// Static assets only: no Worker script, so asset requests are free and unlimited
// (https://developers.cloudflare.com/workers/static-assets/billing-and-limitations/).
{
  "name": "matchqueue-web",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "build/web",
    // Flutter is a SPA: unknown paths fall back to index.html (refresh on /route never 404s).
    "not_found_handling": "single-page-application"
  }
  // Custom domain: ONLY after the owner authorises DNS changes. Uncomment, then deploy.
  // "routes": [{ "pattern": "matchqueue.lucksrei.com", "custom_domain": true }]
}
